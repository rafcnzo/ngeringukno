{
  "name": "ngeringukno",
  "version": "0.7.0",
  "main": "src/main/main.js",
  "bin": {
    "ngeringukno": "src/main/cli.js"
  },
  "scripts": {
    "start": "electron .",
    "dev": "node scripts/dev.js",
    "test": "node --test",
    "dist": "electron-builder",
    "release": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags"
  },
  "keywords": [],
  "author": "rafcnzo",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "description": "made for humans, Ngeringukno - audio player.",
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "cfonts": "^3.3.1",
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.8.9",
    "hls.js": "^1.7.1",
    "tone": "^15.1.22"
  },
  "productName": "Ngeringukno",
  "homepage": "https://github.com/rafcnzo/ngeringukno",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafcnzo/ngeringukno.git"
  },
  "bugs": {
    "url": "https://github.com/rafcnzo/ngeringukno/issues"
  },
  "build": {
    "appId": "io.github.rafcnzo.ngeringukno",
    "productName": "Ngeringukno",
    "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "vendor/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "AudioVideo"
    },
    "mac": {
      "icon": "assets/icon-1024.png",
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "rafcnzo",
        "repo": "ngeringukno",
        "releaseType": "release"
      }
    ],
    "afterPack": "scripts/mac-adhoc-sign.js"
  }
}
